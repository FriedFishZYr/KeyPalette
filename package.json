{
  "name": "keypalette",
  "version": "3.1.0",
  "private": true,
  "description": "Design and preview custom keycap colorways in the browser. No account, no install.",
  "keywords": [
    "keyboard",
    "keycaps",
    "colorway",
    "mechanical-keyboard",
    "design",
    "react",
    "vite"
  ],
  "license": "MIT",
  "author": "FriedFishZYr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FriedFishZYr/KeyPalette.git"
  },
  "bugs": {
    "url": "https://github.com/FriedFishZYr/KeyPalette/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "vite": "^8.0.3",
    "vitest": "^5.0.0"
  }
}
